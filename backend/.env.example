# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development

# PostgreSQL. Local: `docker compose up -d db` (port 5433). Hosted: paste the provider's URL;
# postgres:// and postgresql:// URLs are rewritten to the psycopg driver automatically.
DATABASE_URL=postgresql+psycopg://scanner:scanner@localhost:5433/scanner

# Google Gemini (server-side only). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
MODEL_MAX_ATTEMPTS=3
MODEL_TIMEOUT_SECONDS=90
EXTRACTION_PASSES=1
DAILY_MODEL_CALL_LIMIT=500

# Browser origin(s) allowed by CORS, comma-separated. Production: your Vercel URL, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# Optional: require this code (entered once in the browser) for every API call on a public demo.
DEMO_ACCESS_CODE=

# Receipt originals: "database" (persists on hosts with ephemeral disks) or "local" (UPLOAD_DIR).
STORAGE_BACKEND=database
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
UPLOADS_PER_HOUR_PER_CLIENT=30

# Worker: "inline" runs extraction in a thread inside the API process; "off" if you run `python -m app.worker`.
WORKER_MODE=inline
AUTO_APPROVE_CLEAN_RECEIPTS=false
RECEIPT_MAX_AGE_DAYS=730
